__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.hypothesis/
.benchmarks/

# ---------------------------------------------------------------------------
# Runtime output & private/mutable state.
# These stay on disk so the agents keep working locally; they are never tracked.
# The AI resource governor CODE and CONFIG under .runtime/ai-resource-governor/
# (ai_governor.py, bin/, scripts/, tests/, policy.json, model-roster.json, *.md)
# ARE tracked; only its mutable receipts/state below are ignored.
# ---------------------------------------------------------------------------
.runtime/archives/
.runtime/backups/
# All state under .runtime/ is local-only and NOT tracked. The AI resource
# governor's code/config lives here for historical reasons and is the only
# whitelisted subtree; its mutable receipts/state stay ignored.
/.runtime/*
!/.runtime/ai-resource-governor/
/.runtime/ai-resource-governor/*
!/.runtime/ai-resource-governor/ai_governor.py
!/.runtime/ai-resource-governor/bin/
!/.runtime/ai-resource-governor/scripts/
!/.runtime/ai-resource-governor/tests/
!/.runtime/ai-resource-governor/policy.json
!/.runtime/ai-resource-governor/model-roster.json
!/.runtime/ai-resource-governor/*.md
/.runtime/ai-resource-governor/receipts/
/.runtime/ai-resource-governor/repair-queue.jsonl
.runtime/**/*.sqlite
.runtime/**/*.sqlite-wal
.runtime/**/*.sqlite-shm
.runtime/**/*.log

# Top-level generated run dumps.
ORCHESTRATOR_OUTPUT/

# Generated dashboard data (contains live financials / customer PII).
orchestrator/ui/static/business_snapshot.json

# Transient benchmark run outputs (kept locally, not committed).
benchmark_results/

# ---------------------------------------------------------------------------
# Secrets & credentials — never track. .env.example is the tracked template.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
**/token.json
**/credentials.json
**/service-account*.json
**/client_secret*.json
**/*secret*.json

# ---------------------------------------------------------------------------
# Editor / OS / backup noise.
# ---------------------------------------------------------------------------
.venv/
venv/
*.egg-info/
dist/
build/
*.bak
*.bak.*
*.tmp
.DS_Store
Thumbs.db
